<Window x:Class="Pulse.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Pulse.Views"
        Title="PULSE" Width="1110" Height="744" MinWidth="785" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="41" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
    </Window.InputBindings>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="41" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" />
            <Grid Grid.RowSpan="3">
                <Grid.RowDefinitions><RowDefinition Height="91" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Width="37" Height="37" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Image x:Name="Brand" Width="28" Height="25" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="BrandFallback" Text="P" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PULSE" FontWeight="Bold" FontSize="19" />
                        <TextBlock Text="Windows Tweaker" Style="{StaticResource Meta}" Margin="0,0,0,1" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,8,0">
                    <ItemsControl ItemsSource="{Binding Navigation}" Margin="2,0,2,5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Page}" AutomationProperties.Name="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="15,0" Padding="5,15">
                    <Grid>
                        <TextBlock Text="PULSE v0.1" Style="{StaticResource Meta}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeClick" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="MaximizeClick" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="CloseClick" />
                    </StackPanel>
                    <Border x:Name="SearchFrame" DockPanel.Dock="Right" Width="239" Height="27" VerticalAlignment="Center" Margin="8,0,10,0"
                            Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Search tweaks and apps" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Meta}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="12" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search tweaks and apps" />
                            <TextBlock Grid.Column="2" Text="Ctrl+F" Style="{StaticResource Meta}" FontSize="10" Margin="4,0,7,0" VerticalAlignment="Center">
                                <TextBlock.Visibility>
                                    <Binding Path="SearchActive">
                                        <Binding.Converter><views:InverseVisibilityConverter /></Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Width="24" MinHeight="0" Padding="0"
                                    Content="×" FontSize="17" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchActive, Converter={StaticResource BoolVisibility}}" ToolTip="Clear search" AutomationProperties.Name="Clear search" />
                        </Grid>
                    </Border>
                    <Grid />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageBody" Margin="27,24,27,24">
                    <DockPanel Margin="0,0,0,22" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Margin="13,5,0,0" VerticalAlignment="Top"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh system settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Secondary}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <views:OverviewView Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}" />
                    <views:CatalogView Visibility="{Binding IsCatalog, Converter={StaticResource BoolVisibility}}" />
                    <views:RestoreView Visibility="{Binding IsRestore, Converter={StaticResource BoolVisibility}}" />
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Grid.Row="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Background="{StaticResource BlueSurface}" Padding="15,9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="60" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <DockPanel Margin="20,11">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Content="Clear" Style="{StaticResource QuietButton}" Command="{Binding ClearCommand}" Margin="0,0,5,0" />
                            <Button Content="Apply changes" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" MinWidth="125" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Foreground="{StaticResource LightBlue}" FontSize="16" Margin="4,0,0,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectionHint}" Style="{StaticResource Meta}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Meta}" Foreground="{StaticResource LightBlue}"
                                           Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
