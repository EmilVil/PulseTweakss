<UserControl x:Class="Pulse.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Background="{StaticResource AmberSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="15,12" Margin="0,0,0,12"
                Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" Text="&#xE7BA;" Margin="0,0,11,0" />
                <TextBlock Text="Power plan changes affect the whole device. Review battery and heat implications before applying." Foreground="{StaticResource Amber}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Border Background="{StaticResource AmberSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="15,12" Margin="0,0,0,12"
                Visibility="{Binding ShowPackageError, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding PackageError}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" />
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
            <StackPanel>
                <Border Style="{StaticResource Rule}" Padding="15,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Queue" Style="{StaticResource Meta}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding CatalogLabel}" Style="{StaticResource Heading}" />
                    </DockPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding VisibleRows}" IsEnabled="{Binding Idle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15,13" Style="{StaticResource Rule}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="168" /><ColumnDefinition Width="45" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Info.Description}" Style="{StaticResource Meta}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,7,0,0">
                                            <TextBlock Text="{Binding RiskLabel}" Margin="0,0,9,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Meta}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsModerate}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Info.Compatibility}" Style="{StaticResource Meta}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Info.Impact}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding IsModerate, Converter={StaticResource BoolVisibility}}" />
                                        <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource Meta}" Foreground="{StaticResource Amber}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,11,0">
                                        <TextBlock Text="{Binding CurrentLabel, StringFormat='Current · {0}'}" Style="{StaticResource Meta}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Target.Label, StringFormat='Change to · {0}'}" Foreground="{StaticResource LightBlue}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding HasFixedTarget, Converter={StaticResource BoolVisibility}}" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Target, Mode=TwoWay}" MinHeight="29"
                                                  Margin="0,5,0,0" AutomationProperties.Name="{Binding Info.Name, StringFormat='Target for {0}'}"
                                                  Visibility="{Binding HasChoices, Converter={StaticResource BoolVisibility}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding CanStage}" IsChecked="{Binding Staged, Mode=TwoWay}"
                                              Style="{StaticResource Toggle}" ToolTip="Select for review"
                                              AutomationProperties.Name="{Binding Info.Name, StringFormat='Queue {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Reading the available settings…" Style="{StaticResource Secondary}" Margin="15,13"
                           Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding EmptyLabel}" Style="{StaticResource Secondary}" Margin="15,13"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Visibility="{Binding HasLinks, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <Border Style="{StaticResource Rule}" Padding="15,12"><TextBlock Text="Windows Settings" Style="{StaticResource Heading}" /></Border>
                <ItemsControl ItemsSource="{Binding VisibleLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15,12" Style="{StaticResource Rule}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="{Binding Action}" VerticalAlignment="Center" Margin="12,0,0,0"
                                            CommandParameter="{Binding}" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
