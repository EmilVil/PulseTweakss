<UserControl x:Class="Pulse.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid x:Name="OverviewGrid" SizeChanged="Reflow">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ProfileColumn" Width="278" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border x:Name="ActivityCard" Style="{StaticResource Panel}" Margin="0,0,14,0">
                <StackPanel>
                    <Border Style="{StaticResource Rule}" Padding="17,14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource LightBlue}" Margin="0,0,6,0"
                                         Visibility="{Binding LiveMonitoring, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock Text="{Binding MonitorLabel}" Style="{StaticResource Meta}" />
                            </StackPanel>
                            <TextBlock Text="Live activity" Style="{StaticResource Heading}" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="17,18,17,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="CPU utilization" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding CpuLabel}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <ProgressBar Style="{StaticResource MetricBar}" Value="{Binding CpuPercent, Mode=OneWay}" AutomationProperties.Name="CPU utilization" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Memory usage" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding RamLabel}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <ProgressBar Style="{StaticResource MetricBar}" Value="{Binding RamPercent, Mode=OneWay}" AutomationProperties.Name="Memory usage" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="17,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                    <Grid Margin="17,13,17,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="System uptime" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding Uptime}" Margin="0,3,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Physical memory in use" Style="{StaticResource Meta}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RamUsage}" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="ProfileCard" Grid.Column="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <Border Style="{StaticResource Rule}" Padding="14,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Meta}" Foreground="{StaticResource LightBlue}" />
                            </Border>
                            <TextBlock Text="Tuning profiles" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="6,5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="8,5" MinHeight="37"
                                        Command="{Binding DataContext.ProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Profile}" AutomationProperties.Name="{Binding Name}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="9" Margin="8,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Meta}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Panel}" Margin="0,15,0,0">
            <StackPanel>
                <Border Style="{StaticResource Rule}" Padding="17,14">
                    <TextBlock Text="Device details" Style="{StaticResource Heading}" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Padding="17,13" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1">
                        <StackPanel>
                            <TextBlock Text="Operating system" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding Windows}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="17,13" Style="{StaticResource Rule}">
                        <StackPanel>
                            <TextBlock Text="Processor" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding Cpu}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="17,13" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="Graphics" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding Gpu}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="17,13">
                        <StackPanel>
                            <TextBlock Text="Installed memory" Style="{StaticResource Meta}" />
                            <TextBlock Text="{Binding InstalledRam}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
