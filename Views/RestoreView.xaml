<UserControl x:Class="Pulse.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Panel}">
        <StackPanel>
            <Border Style="{StaticResource Rule}" Padding="15,11">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Export JSON" Command="{Binding ExportCommand}" Margin="12,0,0,0" />
                    <TextBlock Text="Change history" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <TextBlock Text="Changes and their saved original values will appear here after you apply a change."
                       Style="{StaticResource Secondary}" Margin="15,16" TextWrapping="Wrap"
                       Visibility="{Binding HistoryEmpty, Converter={StaticResource BoolVisibility}}" />
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Rule}" Padding="15,13">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Restore original" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding CanRevert, Converter={StaticResource BoolVisibility}}"
                                        Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Transition}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource LightBlue}" FontSize="12" />
                                        <TextBlock Text="  ·  " Style="{StaticResource Meta}" />
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Meta}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Meta}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
