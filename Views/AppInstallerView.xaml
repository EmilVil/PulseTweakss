<UserControl x:Class="Pulse.Views.AppInstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>
    <Grid Margin="24,18,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Install selected" Command="{Binding InstallCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="App Installer" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Browse applications from the WinGet community source."
                           Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <ComboBox DockPanel.Dock="Left" Width="172" Height="34" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding Category, Mode=TwoWay}" Margin="0,0,9,0"
                      AutomationProperties.Name="Filter applications by category"/>
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Height="34">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search applications" AutomationProperties.Name="Search applications" Margin="0,0,10,0"/>
                </Grid>
            </Border>
        </DockPanel>
        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="12,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Install" Style="{StaticResource Meta}"/>
                    <TextBlock Grid.Column="1" Text="Application" Style="{StaticResource Meta}"/>
                    <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource Meta}"/>
                    <TextBlock Grid.Column="3" Text="Availability" Style="{StaticResource Meta}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True" IsDeferredScrollingEnabled="True">
                    <ItemsControl ItemsSource="{Binding VisibleApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Rule}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Available}"
                                                  Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Name}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Grid Width="15" Height="15" Margin="8,0,0,0"
                                                      Visibility="{Binding HasVerifiedSource, Converter={StaticResource BoolVisibility}}"
                                                      ToolTip="Source details checked">
                                                    <Ellipse Stroke="#75C991" StrokeThickness="1.2"/>
                                                    <Path Data="M3.5,7.5 L6.3,10.2 L11.7,4.8" Stroke="#75C991"
                                                          StrokeThickness="1.4" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Grid>
                                                <Button Content="Source details" Margin="8,0,0,0" Padding="0"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource LightBlue}"
                                                        FontSize="11" Cursor="Hand"
                                                        Command="{Binding DataContext.SourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Meta}" TextWrapping="Wrap" MaxWidth="430"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Meta}" TextWrapping="Wrap" MaxWidth="430"
                                                       Visibility="{Binding Note, Converter={StaticResource NonEmptyVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource Meta}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding Progress}" Style="{StaticResource Meta}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
