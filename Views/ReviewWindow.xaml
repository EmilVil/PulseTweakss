<Window x:Class="Pulse.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="585" SizeToContent="Height" MaxHeight="615" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13"
        Title="PULSE" WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ReviewTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ReviewDescription" Style="{StaticResource Secondary}" Margin="0,6,0,15" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="ReviewScroll" Grid.Row="1" MaxHeight="407" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ReviewItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Transition}" Foreground="{StaticResource LightBlue}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Impact}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource Meta}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="81" Margin="0,0,7,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Click="ConfirmClick" MinWidth="106" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
